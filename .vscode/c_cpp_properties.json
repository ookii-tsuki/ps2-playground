{
    "configurations": [
        {
            "name": "PS2",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/local/ps2dev/ps2sdk/ee/include",  // Path to EE includes
                "/usr/local/ps2dev/ps2sdk/common/include",  // Path to common includes
                "/usr/local/ps2dev/ps2sdk/iop/include"  // Path to IOP includes
            ],
            "defines": ["PS2_EE"],
            "compilerPath": "/usr/local/ps2dev/ee/bin/mips64r5900el-ps2-elf-gcc",  // Path to EE GCC compiler
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "/usr/local/ps2dev/ps2sdk/ee/include",
                    "/usr/local/ps2dev/ps2sdk/common/include",
                    "/usr/local/ps2dev/ps2sdk/iop/include"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            }
        }
    ],
    "version": 4
}
